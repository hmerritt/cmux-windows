{
  "name": "cmux",
  "version": "0.1.0",
  "productName": "cmux",
  "private": true,
  "description": "cmux desktop app for Windows with terminal workspaces, browser panes, notifications, and customization.",
  "author": {
    "name": "Nikku"
  },
  "homepage": "https://github.com/imthegoodboy/cmux-window",
  "main": "src/main.cjs",
  "scripts": {
    "build:shortcuts": "node scripts/export-shortcuts.cjs",
    "build:documents": "node scripts/export-document-assets.cjs",
    "build:locales": "npm run build:shortcuts && node scripts/export-locales.cjs && npm run build:documents",
    "build:renderer": "npm run build:locales && vite build --mode production --config vite.renderer.config.mjs",
    "build:renderer:dev": "npm run build:locales && vite build --mode development --config vite.renderer.config.mjs",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --x64",
    "pack:win": "npm run build:renderer && electron-builder --win dir --x64",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer:dev && electron .",
    "cli": "node src/cli.cjs",
    "smoke": "node src/smoke.cjs",
    "test:desktop": "node tests/run-desktop.cjs",
    "test:packaged": "node tests/packaged-smoke.cjs",
    "test:shortcuts": "electron tests/shortcuts-desktop.cjs",
    "test:parity": "electron tests/parity-desktop.cjs",
    "test:documents": "electron tests/documents-desktop.cjs",
    "test:search": "electron tests/search-desktop.cjs",
    "test:files": "electron tests/file-mutations-desktop.cjs",
    "test:restore": "node tests/run-session-restore.cjs",
    "test:browser-layout": "electron tests/browser-layout-desktop.cjs",
    "test:paste": "electron tests/paste-desktop.cjs",
    "test:tabs": "node tests/run-tab-interactions.cjs",
    "test:sidebar": "electron tests/sidebar-layout-desktop.cjs",
    "pretest": "npm run build:locales",
    "test": "node --test tests/*.test.cjs",
    "presmoke": "npm run build:locales",
    "pretest:desktop": "npm run build:locales"
  },
  "dependencies": {
    "@xterm/addon-image": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  },
  "build": {
    "appId": "com.cmux.windows",
    "productName": "cmux",
    "executableName": "cmux",
    "artifactName": "cmux-${version}-setup.${ext}",
    "copyright": "Copyright © 2026 Nikku",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "src/**/*",
      "renderer/**/*"
    ],
    "win": {
      "icon": "src/assets/cmux.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "cmux",
      "uninstallDisplayName": "cmux ${version}",
      "installerIcon": "src/assets/cmux.ico",
      "uninstallerIcon": "src/assets/cmux.ico",
      "installerHeaderIcon": "src/assets/cmux.ico"
    }
  }
}
